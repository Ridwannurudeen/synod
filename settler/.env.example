# Synod settler environment variables
#
# Copy to .env and fill in keys for the providers this settler will use.
# A single settler typically runs ONE provider (heterogeneity comes from
# multiple settler nodes running different providers).

# LLM provider for this settler (one of: anthropic, openai, gemini)
SYNOD_PROVIDER=anthropic

# Provider API keys (set the one that matches SYNOD_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Model identifier — passed to the provider SDK
# Defaults if unset:
#   anthropic -> claude-sonnet-4-6
#   openai    -> gpt-4o
#   gemini    -> gemini-2.0-flash
SYNOD_MODEL=

# AXL daemon this settler talks to
SYNOD_AXL_API=http://127.0.0.1:9002

# Path to the ed25519 identity key for this settler. Must match the AXL node's
# PrivateKeyPath so that votes are signed with the same identity that AXL peers
# know on the wire.
SYNOD_IDENTITY_KEY=../keys/node-a.pem

# Comma-separated list of peer public keys (hex, 64 chars each) to broadcast
# votes to. Use the value of /topology -> our_public_key from each peer node.
SYNOD_PEER_KEYS=

# Quorum threshold for consensus (k of n distinct settler signatures required)
SYNOD_QUORUM=2

# Optional on-chain posting. Leave unset for off-chain-only verifier nodes.
SYNOD_RPC_URL=
SYNOD_REGISTRY_ADDRESS=
SYNOD_EVM_KEY=
